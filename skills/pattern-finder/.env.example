# Phase A — Vision-matching fallback (optional)
# Required only if you run `pnpm ai-migrate vision` to upgrade medium/low/none-tier
# DOM matches via Claude. Skip if you're happy with DOM-only matching.
ANTHROPIC_API_KEY=sk-ant-...

